BOT_TOKEN=
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
GEMINI_API_KEY=

# Premiere/AE plugin's translation-transcription and B-roll features proxy through this
# server (proxy_server.py/broll.py) — these keys only need to live here, never in a
# distributed plugin install.
PEXELS_API_KEY=
GIPHY_API_KEY=
PIXABAY_API_KEY=

# Optional: from my.telegram.org ("API development tools"). When both are set, the bot
# routes through a self-hosted local Bot API server (see run-telegram-bot-api.md / the
# `telegram-bot-api` Docker container) instead of Telegram's cloud API, raising the file
# download cap from the cloud API's hard 20MB to 500MB. Leave blank to stay on the cloud API.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOCAL_BOT_API_URL=http://127.0.0.1:8081

# --- Litsenziya / to'lov ---
# @userinfobot ga yozib o'z Telegram user ID'ingizni oling.
ADMIN_TELEGRAM_ID=
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
# Tariff durations/prices are hardcoded in config.py (TARIFFS) — not secrets, just product
# pricing, so no env var for them.
LICENSE_SERVER_HOST=0.0.0.0
LICENSE_SERVER_PORT=8899
